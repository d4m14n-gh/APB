      </bpmn:extensionElements>
      <bpmn:incoming>Flow_150rp0f</bpmn:incoming>
      <bpmn:outgoing>Flow_0eg6zvd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0eg6zvd" sourceRef="Activity_1ms1gcn" targetRef="Gateway_1rxczw8" />
    <bpmn:userTask id="Activity_1kwsath" name="Wprowadź potrzeby klienta do systemu">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:priorityDefinition priority="50" />
        <zeebe:formDefinition formId="Form_PreferencjePojazdu_C8" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;preferred_brand&#34;: &#34;bmw&#34;,&#10;  &#34;preferred_body_type&#34;: &#34;suv&#34;,&#10;  &#34;preferred_max_price&#34;: 250000,&#10;  &#34;approved&#34;: true&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ejmc86</bpmn:incoming>
      <bpmn:outgoing>Flow_0yp09eu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_03xcqp3" name="Dopasuj optymalny model do preferencji">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#34;recommended_model_id&#34;: &#34;BMW_X3&#34;}" />
        </zeebe:properties>
        <zeebe:script expression="=if preferred_brand = &#34;toyota&#34;&#10;   and preferred_body_type = &#34;suv&#34;&#10;then &#34;Toyota_RAV4&#34;&#10;&#10;  &#10;else if preferred_brand = &#34;toyota&#34;&#10;  and preferred_body_type = &#34;sedan&#34;&#10;then &#34;Toyota_Corolla&#34;&#10;&#10;  &#10;else if preferred_brand = &#34;bmw&#34;&#10;   and preferred_body_type = &#34;suv&#34; &#10;then &#34;BMW_X3&#34;&#10;&#10;  &#10;else if preferred_brand = &#34;audi&#34;&#10;   and preferred_body_type = &#34;kombi&#34; &#10;then &#34;Audi_A4&#34;&#10;&#10;  &#10;else if preferred_brand = &#34;mercedes&#34;&#10;   and preferred_body_type = &#34;sedan&#34;&#10;then &#34;Mercedes_C-Class&#34;&#10;&#10;  &#10;else if preferred_brand = &#34;volkswagen&#34;&#10;   and preferred_body_type = &#34;hatchback&#34;&#10;   &#10;then &#34;Volkswagen_Golf&#34;&#10;&#10;else&#10;  &#34;Toyota_Corolla&#34;" resultVariable="recommended_model_id" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d255ub</bpmn:incoming>
      <bpmn:outgoing>Flow_06vbvzq</bpmn:outgoing>
    </bpmn:scriptTask>
  </bpmn:process>
