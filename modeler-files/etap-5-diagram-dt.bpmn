    <bpmn:serviceTask id="Activity_0gykq7b" name="Sprawdź dostępność pojazdu">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=recommended_model_id" target="recommended_model_id" />
          <zeebe:output source="=is_available" target="is_available" />
          <zeebe:output source="=car" target="car" />
        </zeebe:ioMapping>
        <zeebe:taskDefinition type="is_available" retries="1" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;is_available&#34;: true,&#10;  &#34;car&#34;: {&#10;    &#34;vin&#34;: &#34;1HGCM82633A123456&#34;,&#10;    &#34;model_id&#34;: &#34;BMW_X3&#34;,&#10;    &#34;brand&#34;: &#34;BMW&#34;,&#10;    &#34;model_name&#34;: &#34;X3&#34;,&#10;    &#34;year&#34;: 2023,&#10;    &#34;color&#34;: &#34;black&#34;,&#10;    &#34;car_body_type&#34;: &#34;suv&#34;,&#10;    &#34;price&#34;: 245000,&#10;    &#34;image&#34;: &#34;https://upload.wikimedia.org/wikipedia/commons/thumb/f/f6/Toyota_Corolla_Limousine_Hybrid_Genf_2019_1Y7A5576.jpg/960px-Toyota_Corolla_Limousine_Hybrid_Genf_2019_1Y7A5576.jpg&#34;&#10;  }&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06vbvzq</bpmn:incoming>
      <bpmn:outgoing>Flow_007i1c8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_0ogucxs" name="Zaprezentuj pojazd">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;&#34;accepted&#34;: true&#10;}" />
        </zeebe:properties>
        <zeebe:formDefinition formId="zaprezentuj-pojazd-1bxi5oz" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06m9v3d</bpmn:incoming>
      <bpmn:outgoing>Flow_1ugrb9g</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1h7c3qd" name="Czy pojazd jest dostępny do prezentacji?">
      <bpmn:incoming>Flow_007i1c8</bpmn:incoming>
      <bpmn:outgoing>Flow_06m9v3d</bpmn:outgoing>
      <bpmn:outgoing>Flow_150rp0f</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_06m9v3d" name="Tak" sourceRef="Gateway_1h7c3qd" targetRef="Activity_0ogucxs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=is_available = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_150rp0f" name="Nie" sourceRef="Gateway_1h7c3qd" targetRef="Activity_1ms1gcn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=is_available = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
