    <bpmn:userTask id="Activity_1ms1gcn" name="Wyklucz pojazd i powiadom klienta o braku dostępności">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;excluded_models&#34;: [&#10;    &#34;BMW_X3&#34;&#10;  ]&#10;}" />
